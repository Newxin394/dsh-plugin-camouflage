{
  "name": "dsh-plugin-camouflage",
  "version": "1.1.4",
  "description": "AI自用 —— DeepSeek Harness (DSH) 客户端身份伪装插件：为上游 LLM 请求自动伪装 Client User-Agent（如 Cline/3.0.0）。仅供个人学习与自用测试。",
  "type": "module",
  "main": "index.js",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "camouflage",
    "user-agent"
  ],
  "license": "MIT",
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "exports": {
    ".": "./index.js",
    "./settings": "./settings.js",
    "./settings.js": "./settings.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  }
}