{
  "name": "dsh-plugin-camouflage",
  "version": "1.5.0",
  "description": "AI自用 —— DeepSeek Harness (DSH) 客户端身份伪装与自定义模型思考能力插件：出网伪装 Client User-Agent、额外 HTTP 请求头，并为自定义提供方提供模型思考能力（Reasoning Efforts / 思考等级切换器）与多模态扩展支持。仅供个人学习与自用测试。",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/",
    "check": "node --check index.js && node --check settings.js && node --check client.js && node --test test/"
  },
  "files": [
    "index.js",
    "settings.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "camouflage",
    "user-agent"
  ],
  "license": "MIT",
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "exports": {
    ".": "./index.js",
    "./settings": "./settings.js",
    "./settings.js": "./settings.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  }
}
